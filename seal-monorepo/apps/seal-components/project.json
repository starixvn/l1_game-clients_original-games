{
  "name": "seal-components",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/seal-components/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "options": {
        "outputPath": "dist/apps/seal-components",
        "webpackConfig": "apps/seal-components/webpack.config.js",
        "tsConfig": "apps/seal-components/tsconfig.app.json",
        "assets": [
          {
            "input": "dist/libs",
            "glob": "**/*",
            "ignore": ["**/*.js"],
            "output": "dist/app/seal-components"
          }
        ]
      },
      "configurations": {
        "production": {
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "vendorChunk": false,
          "buildOptimizer": true,
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            }
          ]
        }
      }
    }
  },
  "tags": []
}
