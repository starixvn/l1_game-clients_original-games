{
    "name": "my-app",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev -p 3001",
        "dev-node18": "set NODE_OPTIONS=--openssl-legacy-provider && next dev -p 3001",
        "build": "next build",
        "build-node18": "set NODE_OPTIONS=--openssl-legacy-provider && next build",
        "start": "PORT=5000 next start",
        "start:window": "next start -p 5000",
        "lint": "next lint",
        "test": "jest",
        "test:watch": "jest --watch",
        "test-coverage": "jest --coverage",
        "reg": "npm set registry http://npm.lumigame.com",
        "linkToSGGameClient": "yarn link @sg/sg-game-client"
    },
    "dependencies": {
        "@sg/sg-game-client": "0.1.1-beta.3",
        "@sg/sg-observer": "^1.3.3",
        "axios": "^1.7.4",
        "bootstrap": "^5.3.3",
        "interweave": "^13.1.0",
        "inversify": "^6.0.2",
        "lodash": "^4.17.21",
        "mobx": "6.9.0",
        "mobx-logger": "^0.7.1",
        "next": "^14.2.5",
        "react": "^18.3.1",
        "react-bootstrap": "^2.10.4",
        "react-device-detect": "^2.2.3",
        "react-dom": "^18.3.1",
        "reflect-metadata": "^0.2.2",
        "sass": "^1.43.4",
        "uuid": "^10.0.0"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.14.5",
        "@babel/preset-react": "^7.14.5",
        "@commitlint/cli": "^13.1.0",
        "@commitlint/config-conventional": "^13.1.0",
        "@types/enzyme": "^3.10.8",
        "@types/enzyme-adapter-react-16": "^1.0.6",
        "@types/jest": "^26.0.23",
        "@types/lodash": "^4.17.7",
        "@types/react": "17.0.9",
        "@types/react-dom": "^18.0.10",
        "@types/uuid": "^8.3.0",
        "babel-core": "^6.26.3",
        "babel-jest": "^27.0.2",
        "critters": "^0.0.16",
        "enzyme": "^3.11.0",
        "enzyme-adapter-react-16": "^1.15.6",
        "enzyme-to-json": "^3.6.2",
        "eslint": "^8",
        "eslint-config-next": "^14.2.5",
        "husky": "^7.0.1",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^27.0.4",
        "jest-extended": "^0.11.5",
        "jest-sonar-reporter": "^2.0.0",
        "react-test-renderer": "^17.0.2",
        "ts-jest": "^27.0.3",
        "ts-node": "^10.4.0",
        "typescript": "5.5.4"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
