FROM hub.lumigame.com/base/node:20.9.0-alpine-24h1.1 AS base

FROM base AS deps
WORKDIR /app

# Add dependencies for native builds
RUN apk add --no-cache libc6-compat python3 make g++
ENV YARN_CACHE_FOLDER=/root/.yarn

# Install dependencies with cache mount
COPY package.json yarn.lock ./
COPY apps/saba-games/package.json ./apps/saba-games/
COPY libs/ ./libs/
RUN --mount=type=cache,target=$YARN_CACHE_FOLDER \
     yarn install --frozen-lockfile --network-timeout 1000000

FROM base AS builder
WORKDIR /app

# Copy all files needed for build
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Build the project
RUN yarn nx build saba-games --prod

FROM hub.lumigame.com/base/node:20.9.0-alpine-24h1.1 AS runner
WORKDIR /app
ENV NODE_ENV production

# Create non-root user
RUN addgroup --system --gid 1001 nodejs \
     && adduser --system --uid 1001 nextjs

# Copy build output
COPY --from=builder /app/dist/apps/saba-games ./
COPY --from=builder /app/node_modules ./node_modules

# Set permissions
RUN chown -R nextjs:nodejs /app

USER nextjs

EXPOSE 5000
ENV PORT 5000
ENV HOST 0.0.0.0

CMD ["node", "main.js"]
