FROM hub.lumigame.com/base/node:20.9.0-alpine-24h1.1 AS base

FROM base AS deps
WORKDIR /app

# Add dependencies for native builds
RUN apk add --no-cache libc6-compat python3 make g++
ENV YARN_CACHE_FOLDER=/root/.yarn

# Install dependencies with cache mount
COPY package.json yarn.lock ./
RUN --mount=type=cache,target=$YARN_CACHE_FOLDER \
     yarn install --frozen-lockfile --network-timeout 1000000

FROM base AS builder
WORKDIR /app

# Copy dependencies and all source files
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json
COPY . .

# Build the project
RUN yarn build && \
     yarn start:window

FROM hub.lumigame.com/base/node:20.9.0-alpine-24h1.1 AS runner
WORKDIR /app
ENV NODE_ENV production

# Create non-root user
RUN addgroup --system --gid 1001 nodejs \
     && adduser --system --uid 1001 nextjs

# Copy build output
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/public ./public

# Set permissions
RUN chown -R nextjs:nodejs /app

USER nextjs

EXPOSE 5000
ENV PORT 5000
ENV HOST 0.0.0.0

CMD ["yarn", "start:window"]
